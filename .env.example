# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in your values
# The .env file is gitignored and will NEVER be committed to GitHub.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your real values
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres1
POSTGRES_PASSWORD=your_postgres_password_here

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/citizen-portal

# ── Mail (Notification Service) ───────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# ── CORS (API Gateway) ────────────────────────────────────────────────────────
# In production, set this to your deployed frontend URL
ALLOWED_ORIGINS=http://localhost:4200
